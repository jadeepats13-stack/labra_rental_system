# Copy this file to .env and paste your own values. Never put real keys here:
# this file goes to GitHub, .env does not.

# Django
DJANGO_SECRET_KEY=paste-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PayPal Sandbox
PAYPAL_CLIENT_ID=paste-here
PAYPAL_SECRET=paste-here

# OpenWeatherMap
OPENWEATHER_API_KEY=paste-here
COURT_LATITUDE=
COURT_LONGITUDE=
COURT_WEATHER_CITY=Iligan City,PH

# EmailJS
EMAILJS_SERVICE_ID=paste-here
EMAILJS_TEMPLATE_ID=paste-here
EMAILJS_PUBLIC_KEY=paste-here
EMAILJS_PRIVATE_KEY=paste-here
# Second template: 6-digit codes for email confirmation + forgot password (API_SETUP.md section 11)
EMAILJS_CODE_TEMPLATE_ID=paste-here

# Google Calendar (OAuth)
GOOGLE_CLIENT_ID=paste-here
GOOGLE_CLIENT_SECRET=paste-here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/oauth2callback/

# goQR.me QR codes: free, no key needed

# Google Gemini (landing page chatbot)
GEMINI_API_KEY=paste-here
GEMINI_MODEL=gemini-flash-lite-latest
CHATBOT_HOURLY_LIMIT=20
CHATBOT_DAILY_AI_LIMIT=200
